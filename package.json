{
  "name": "lago-homestay",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run format:check && npm run check:architecture && npm run typecheck && npm test && npm run build",
    "images:import": "node scripts/import-laka-images.mjs",
    "qa:images": "node scripts/qa-laka-images.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev --skip-seed",
    "db:seed:demo": "prisma db seed"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@prisma/client": "^6.19.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.62.0",
    "postcss": "^8.4.49",
    "prettier": "3.6.2",
    "prisma": "^6.19.1",
    "sharp": "0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
